# Port the API listens on
PORT=4000

# development | production
NODE_ENV=development

# Comma-separated list of origins allowed by CORS
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/rk-source

# Secret used to sign JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production without it.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# How long a login token stays valid
JWT_EXPIRES_IN=7d

# bcrypt cost factor for password hashing
BCRYPT_ROUNDS=12

# --- Driver invitations and email ---
# Public URL of the frontend, used to build the activation link in the email
APP_URL=http://localhost:5173

# How long a driver invitation stays valid
INVITE_EXPIRES_DAYS=7

# Leave SMTP_HOST empty to have emails written to .devlogs/outbox instead of
# being sent. Set it to switch on real delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@rk-source.local
