{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": true,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 60000
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "npm run *": "allow",
      "npm test*": "allow",
      "npm install": "ask",
      "npm ci": "ask",
      "npx eslint*": "allow",
      "npx vite*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "pwd": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "rm *": "deny",
      "rm -rf *": "deny",
      "git reset --hard*": "deny",
      "git push --force*": "deny"
    },
    "edit": "allow",
    "webfetch": "allow"
  }
}
